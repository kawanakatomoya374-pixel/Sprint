# A complete x86-64 boot chain written and assembled entirely in Sprint (no external assembler, linker or C):
#
#   stage 1  boot sector (512 bytes, real mode, 0x7C00): initialises the stack, reads stage 2 from disk with INT 13h extensions
#   stage 2  (real mode, 0x8000): enables A20, loads a GDT, enters 32-bit protected mode
#   stage 3  (32-bit): builds nothing at run time - the page tables are data generated by this script - enables PAE, long mode and paging
#   kernel   (64-bit): initialises COM1, prints through the serial port and the VGA text buffer, computes with 64-bit arithmetic, halts
#
# usage:  sprint run --allow-write=DIR examples/boot/boot.sp OUT.img
#         qemu-system-x86_64 -drive format=raw,file=OUT.img -serial stdio -display none
# (the GDT descriptors, the page tables and the message strings are produced by Sprint code below and spliced into the assembly)
import asm
import fs
import sys

let out = sys.args[0] if len(sys.args) > 0 else "boot.img"

# ---- data generated by Sprint ---------------------------------------------------------------------
func hex(v, digits = 16):
    let d = "0123456789abcdef"
    let s = ""
    for i in range(digits):
        s = d.slice((v >> (4 * (digits - 1 - i))) & 15, ((v >> (4 * (digits - 1 - i))) & 15) + 1) .. s.slice(0, 0) .. s
    return s

# one hex digit string, most significant first
func hexs(v, digits):
    let d = "0123456789abcdef"
    let s = ""
    for i in range(digits):
        let k = digits - 1 - i
        s = s .. d.slice((v >> (4 * k)) & 15, ((v >> (4 * k)) & 15) + 1)
    return s

# a segment descriptor: base / limit / access byte / flags nibble
func descriptor(base, limit, access, flags):
    let lo = (limit & 0xffff) | ((base & 0xffffff) << 16)
    let hi = ((base >> 24) & 0xff) | ((limit >> 16) & 0xf) << 8 | 0
    let v = (limit & 0xffff) | ((base & 0xffffff) << 16) | (access << 40) | (((limit >> 16) & 0xf) << 48) | (flags << 52) | (((base >> 24) & 0xff) << 56)
    return "dq 0x" .. hexs(v, 16)

let gdt = [
    "dq 0",
    descriptor(0, 0xfffff, 0x9a, 0xc),    # 0x08: 32-bit code, flat 4 GiB
    descriptor(0, 0xfffff, 0x92, 0xc),    # 0x10: 32-bit data, flat 4 GiB
    descriptor(0, 0, 0x9a, 0xa),          # 0x18: 64-bit code (L = 1)
    descriptor(0, 0, 0x92, 0xc)           # 0x20: 64-bit data
]

# identity map the first 8 MiB with 2 MiB pages: PML4 -> PDPT -> PD
func page_tables():
    let t = ""
    t = t .. "align 4096\npml4:\n  dq pdpt + 3\n  times 511 dq 0\n"
    t = t .. "align 4096\npdpt:\n  dq pd + 3\n  times 511 dq 0\n"
    t = t .. "align 4096\npd:\n"
    for i in range(4):
        t = t .. "  dq 0x" .. hexs(i * 0x200000 + 0x83, 16) .. "\n"
    t = t .. "  times 508 dq 0\n"
    return t

func db_string(s):
    let parts = []
    for i in range(len(s)):
        parts.append(to_string(s[i]))
    return "db " .. parts.join(", ") .. ", 0"

# ---- stage 1: the boot sector -----------------------------------------------------------------------
let stage2_sectors = 32
let stage1_src = """
bits 16
org 0x7c00
start:
    cli
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov sp, 0x7c00
    sti
    mov [drive], dl
    mov si, msg_boot
    call print
    mov si, dap
    mov dl, [drive]
    mov ah, 0x42                ; INT 13h extended read
    int 0x13
    jc .fail
    mov si, msg_load
    call print
    mov dl, [drive]
    jmp 0x0000:0x8000
.fail:
    mov si, msg_fail
    call print
.hang:
    hlt
    jmp .hang

print:                          ; ds:si -> zero-terminated string, BIOS teletype
    lodsb
    test al, al
    jz .done
    mov ah, 0x0e
    mov bx, 7
    int 0x10
    jmp print
.done:
    ret

drive: db 0
dap:                            ; disk address packet: read the stage 2 sectors (LBA 1..) to 0x0000:0x8000
    db 0x10, 0
    dw """ .. to_string(stage2_sectors) .. """
    dw 0x8000, 0x0000
    dq 1
msg_boot: """ .. db_string("Sprint boot: stage 1\r\n") .. """
msg_load: """ .. db_string("stage 2 loaded\r\n") .. """
msg_fail: """ .. db_string("disk read failed\r\n") .. """
"""

# ---- stage 2 / 3 / kernel --------------------------------------------------------------------------
let stage2_src = """
bits 16
org 0x8000
stage2:
    mov si, msg_a20
    call print16
    in al, 0x92                 ; fast A20 gate
    or al, 2
    and al, 0xfe
    out 0x92, al
    cli
    lgdt [gdt_ptr]
    mov eax, cr0
    or eax, 1                   ; protected mode
    mov cr0, eax
    jmp dword 0x08:pm32

print16:
    lodsb
    test al, al
    jz .done
    mov ah, 0x0e
    mov bx, 7
    int 0x10
    jmp print16
.done:
    ret

bits 32
pm32:
    mov ax, 0x10
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov esp, 0x7c00
    mov eax, cr4
    or eax, 1 << 5              ; PAE
    mov cr4, eax
    mov eax, pml4
    mov cr3, eax
    mov ecx, 0xc0000080         ; EFER
    rdmsr
    or eax, 1 << 8              ; LME
    wrmsr
    mov eax, cr0
    or eax, 0x80000000          ; paging -> long mode active
    mov cr0, eax
    jmp 0x18:lm64

bits 64
lm64:
    mov ax, 0x20
    mov ds, ax
    mov es, ax
    mov ss, ax
    xor eax, eax
    mov fs, ax
    mov gs, ax
    mov rsp, 0x7c00
    call serial_init
    lea rsi, [rel msg_long]
    call serial_print
    ; 64-bit arithmetic: the 90th Fibonacci number needs more than 32 bits
    xor eax, eax
    mov ebx, 1
    mov ecx, 90
.fib:
    mov rdx, rax
    add rdx, rbx
    mov rax, rbx
    mov rbx, rdx
    dec ecx
    jnz .fib
    call serial_hex             ; prints rax
    lea rsi, [rel msg_done]
    call serial_print
    ; and the VGA text buffer
    mov rdi, 0xb8000
    lea rsi, [rel msg_vga]
    mov ah, 0x1f
.vga:
    lodsb
    test al, al
    jz .vgadone
    stosw
    jmp .vga
.vgadone:
.halt:
    hlt
    jmp .halt

serial_init:
    mov dx, 0x3f9
    xor al, al
    out dx, al                  ; interrupts off
    mov dx, 0x3fb
    mov al, 0x80
    out dx, al                  ; DLAB
    mov dx, 0x3f8
    mov al, 1
    out dx, al                  ; 115200 baud
    mov dx, 0x3f9
    xor al, al
    out dx, al
    mov dx, 0x3fb
    mov al, 3
    out dx, al                  ; 8N1
    ret

serial_putc:                    ; al = byte
    mov r8b, al
    mov dx, 0x3fd
.wait:
    in al, dx
    test al, 0x20
    jz .wait
    mov dx, 0x3f8
    mov al, r8b
    out dx, al
    ret

serial_print:                   ; rsi -> zero-terminated string
    lodsb
    test al, al
    jz .done
    call serial_putc
    jmp serial_print
.done:
    ret

serial_hex:                     ; rax as 16 hex digits
    mov rcx, 16
.next:
    rol rax, 4
    mov rdx, rax
    and edx, 15
    lea rbx, [rel hexdigits]
    mov r9b, [rbx + rdx]
    push rax
    push rcx
    mov al, r9b
    call serial_putc
    pop rcx
    pop rax
    dec rcx
    jnz .next
    ret

hexdigits: db "0123456789abcdef"
msg_a20: """ .. db_string("A20 on, entering protected mode\r\n") .. """
msg_long: """ .. db_string("Sprint long mode: fib(90) = 0x") .. """
msg_done: """ .. db_string("\r\nBOOT OK\r\n") .. """
msg_vga: """ .. db_string("Booted by Sprint") .. """

align 8
gdt_start:
""" .. gdt.join("\n") .. """
gdt_end:
gdt_ptr:
    dw gdt_end - gdt_start - 1
    dd gdt_start

""" .. page_tables()

let s1 = asm.boot_sector(stage1_src)
let s2 = asm.assemble(stage2_src, {bits: 16, org: 0x8000})
# the image: stage 1, then stage 2 padded to whole sectors (plus slack so the BIOS can read the full request)
let img = s1.bytes.copy()
for b in s2.bytes:
    img.append(b)
while len(img) % 512 != 0 or len(img) < 512 * (1 + stage2_sectors):
    img.append(0)
fs.write_bytes(out, img)
print("stage 1: " .. to_string(len(s1.bytes)) .. " bytes, stage 2: " .. to_string(len(s2.bytes)) .. " bytes -> " .. out .. " (" .. to_string(len(img)) .. " bytes)")
