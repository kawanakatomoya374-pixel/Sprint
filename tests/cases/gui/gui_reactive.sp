import gui

let count = gui.state(0)
let on = gui.state(true)
let name = gui.state("Ada")
let doubled = gui.derived([count], func(v): v[0] * 2)
let lbl = gui.label_of(count, func(n): "clicked " .. to_string(n) .. " times")
let dbl = gui.label_of(doubled)
let btn = gui.button("+1", func(b): count.update(func(n): n + 1))
let sl = gui.slider_of(0, 10, count)
let cb = gui.checkbox_of("enabled", on)
let inp = gui.input_of(name)
let prog = gui.progress_of(count, 10)
let hidden = gui.visible_when(gui.label("secret"), on)
let app = gui.show(gui.column([lbl, dbl, btn, sl, cb, inp, prog, hidden]), "reactive")
print(lbl.text, "|", dbl.text, "|", app.width > 20, app.height > 20)
app.click(btn.abs_x() + 4, btn.abs_y() + 4)
app.click(btn.abs_x() + 4, btn.abs_y() + 4)
print(count.get(), lbl.text, dbl.text, sl.value, prog.value)
sl.set_value(7)
print(count.get(), lbl.text, dbl.text)
app.click(cb.abs_x() + 3, cb.abs_y() + 3)
print(on.get(), cb.checked, hidden.visible)
on.set(true)
print(cb.checked, hidden.visible)
inp.set_text("Grace")
print(name.get())
name.set("Linus")
print(inp.text)
app.draw()
print("drawn", app.frames)
