func sums(s):
    let a = 0
    let x = 0
    for i in range(len(s)):
        a += s[i] * ((i % 7) + 1)
        x = (x * 31 + s[i]) & 0xffffff
    return [a, x]

func show(name, bytes):
    let inf = sprintmp3.info(bytes)
    print(name, "info", inf.sample_rate, inf.channels, inf.bitrate_kbps, inf.layer, inf.frames, inf.samples)
    let d = sprintmp3.decode(bytes)
    let s = sums(d.samples)
    print(name, "pcm", d.sample_rate, d.channels, d.frames, len(d.samples), s[0], s[1])

show("stereo", tiny_st)
show("mono", tiny_m2)
let tb = typed.u8(len(tiny_st))
for i in range(len(tiny_st)):
    tb[i] = tiny_st[i]
show("typed", tb)

# garbage and truncation must not crash
try:
    sprintmp3.decode([1, 2, 3, 4, 5, 6, 7, 8])
catch e:
    print("garbage", e.kind)
let cut = []
for i in range(1000):
    cut.append(tiny_st[i])
let c = sprintmp3.decode(cut)
print("truncated", c.frames > 0, c.frames < 11025)
